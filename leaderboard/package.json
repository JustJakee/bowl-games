{
  "name": "leaderboard",
  "version": "3.0.0",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^6.7.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "antd": "^6.0.0",
    "aws-amplify": "^6.10.3",
    "bootstrap": "^5.3.3",
    "cfb.js": "^4.3.2",
    "dotenv": "^16.4.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.30.4",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.23.0",
    "@aws-amplify/backend-cli": "1.8.3",
    "@vitejs/plugin-react": "^6.0.2",
    "aws-cdk-lib": "2.259.0",
    "constructs": "10.6.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  },
  "scripts": {
    "predev": "node scripts/sync-amplify-outputs.js",
    "prestart": "node scripts/sync-amplify-outputs.js",
    "prebuild": "node scripts/sync-amplify-outputs.js",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "amplify:typecheck": "tsc --project tsconfig.amplify.json --noEmit",
    "seed:test26:outputs": "ampx generate outputs --app-id d1mqezo38x3xb8 --branch gen2-updates --out-dir tmp/amplify-outputs-gen2-updates --profile bobs-bowl-games",
    "seed:test26:dry-run": "node scripts/test26/seed-test26.mjs dry-run",
    "seed:test26:apply": "node scripts/test26/seed-test26.mjs apply",
    "season:mark-test": "node scripts/season-mark-test.mjs",
    "test:entry": "tsx --test src/data/canonicalEntry.test.js src/data/entryRepository.test.js",
    "test:picks": "tsx --test src/app/singlePickSetWorkflow.test.js src/data/picksRepository.test.js src/components/picks/pickActions.test.js src/components/picks/picksAutosaveState.test.js src/components/picks/pickSelectionView.test.js src/components/picks/selectedEntryPickLoading.test.js src/components/picks/lockedPicksStatus.test.js src/utils/pickWindow.test.js",
    "test:leaderboard": "tsx --test src/data/leaderboardRepository.test.js src/data/adminEntriesRepository.test.js src/utils/leaderboardScoring.test.js",
    "test:schedule": "node --test src/utils/gamePickSplits.test.js",
    "test:dashboard": "tsx --test src/utils/dashboardEntryProgress.test.js src/utils/adminGameManagement.test.js src/utils/scoreboardGames.test.js",
    "test:seed:test26": "node --test scripts/test26/core.test.mjs",
    "test": "npm run test:entry && npm run test:picks && npm run test:leaderboard && npm run test:schedule && npm run test:dashboard && npm run test:seed:test26"
  },
  "overrides": {
    "@ardatan/relay-compiler@12.0.0": {
      "immutable": "3.8.3"
    },
    "handlebars": "4.7.9",
    "lodash": "4.18.1",
    "tsx": "4.22.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
